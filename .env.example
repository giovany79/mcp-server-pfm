# Environment variables for MCP server
# Copy this file to .env and fill in your actual values

# GitHub Personal Access Token for Azure AI Inference
GITHUB_TOKEN=your_github_token_here

# Portal web automation (Playwright)
PORTAL_LOGIN_URL=https://tu-portal.com/login
PORTAL_USER=tu_usuario_o_correo
PORTAL_PASSWORD=tu_password

# Opcional: URL directa de la pagina donde esta el boton "Excel"
PORTAL_EXPORT_PAGE_URL=

# Opcional: filtros de busqueda antes de exportar
PORTAL_FILTER_REQUERIMIENTO=
PORTAL_FILTER_CEDULA=
PORTAL_FILTER_PROVEEDOR=

# Opcional: comportamiento de ejecucion
PORTAL_DOWNLOAD_DIR=downloads
PORTAL_HEADLESS=false
PORTAL_TIMEOUT_MS=45000
